function [dM_total, IF_ratio] = compute_noise_sensitivity(planetParams, RotPlanet, ...
    B_ACI_mat, Xp, t, angVel, rn, vn, Iner, mask)
    % COMPUTE NOISE SENSITIVITY
    % Description: Given a trajectory and orientation data set, compute the
    % sensitivity of the noise gradiometer compoenents to the NS projection
    % Author: Sergio Coll Ibars
    % Date: 05/21/2025, modified: 07/11/2025
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    % planet variables
    n_max = planetParams(3);
    
    % variables number
    [Nc, Ns, Ncs] = count_num_coeff(n_max); 
     Nt          = length(t);
    
     % a-priori coefficients
    [Cp, Sp] = list2mat(n_max, Nc, Ns, Xp);
    
    % covariance matrix
    R = diag(ones(1, sum(mask)));

    % number of observations
    m = sum(mask);

    % store condition number over time
    dM_total = cell(sum(mask), 1);
    Ax_aug = cell(sum(mask), 1); Ax_proj = Ax_aug;
    for i = 1:m
        Ax_aug{i}  = zeros(Ncs-1, Ncs-1);
        Ax_proj{i} = zeros(Ncs-1, Ncs-1);
        dM_total{i} = zeros(Ncs-1, Ncs-1); 
    end
    fprintf('       Progress:    0%%');  % Initial message
    for j = 3:Nt-2
        % Planet orientation
        maxPos = 3*j; minPos = maxPos - 2;
        ACAF_ACI = RotPlanet(minPos:maxPos, :);

        % from ACI to Nominal body frame
        B_ACI = B_ACI_mat(minPos:maxPos, :);

        % angular vel / acc dyads partials
        [Hrot_omega_dyad, H_omegaDot_dyad, ~, ~] = compute_angularDyadPartials_v2(angVel(:, j), Iner);
       
        % Null space method correcting for attitude
        [Y_ACI, Hc_ACI, ~] = gradiometer_meas(t(j) ,planetParams, ACAF_ACI, [rn(:, j)', vn(:, j)'], ...
                zeros(9, Nt), Cp, Sp);

        % rotate coefficient partials to body frame
        Hc_BODY = rotate_coeffPartials(Hc_ACI, B_ACI);
        Hc = [Hc_BODY(1, 2:end); Hc_BODY(4, 2:end); Hc_BODY(7, 2:end); Hc_BODY(2, 2:end); Hc_BODY(5, 2:end);...
              Hc_BODY(8, 2:end);  Hc_BODY(3, 2:end); Hc_BODY(6, 2:end); Hc_BODY(9, 2:end)];
        
        %  tensor rotation partials
        [Hrot_grad] = compute_rotPartials_analy(Y_ACI, B_ACI);

        % ensamble partials
        Hrot = [Hrot_grad, Hrot_omega_dyad+H_omegaDot_dyad];

        % apply maks to partials
        hrot = Hrot(logical(mask), :);
        hc   =  Hc(logical(mask), :);

        % apply projection
        C = null(hrot');
        
        r = C' * R * C;
        Ax = (C' * hc)' * (r\(C' * hc));

        % compute partial derivative IF w.r.t sigma^2_ij
        dM = derivative_Ht_w_H(hc, C, diag(R));
        
        % store total dM
        dM_total = cellfun(@plus, dM_total, dM, 'UniformOutput', false);

        for i = 1:m
            Ax_proj{i} = Ax_proj{i} + Ax;
            
            RR = R; 
            RR(i, i) = RR(i,i) + 0.44;

            r = C' * RR * C;
            ax = (C' * hc)' * (r\(C' * hc));
            Ax_aug{i} = Ax_aug{i} + ax;
        end
        
        % Update every ~5% (optional)
        if mod(j, round(Nt/20)) == 0 || j == Nt-2
            fprintf('\b\b\b\b%3d%%', round(100 * j / Nt));
        end
    end

    % compute information ratio
    IF_ratio = cell(m, 1);
    for i = 1:m
        IF_ratio{i} = (Ax_aug{i} - Ax_proj{i})./Ax_proj{i}.*100;
        dM_total{i, 1} = -dM_total{i, 1}./Ax_proj{i}.*100;
    end

    fprintf('\nDone!\n');
end


function dM = derivative_Ht_w_H(H, C, R_diag)
    % Computes the derivative of H' * inv(C' * R * C) * H w.r.t. each r_i
    %
    % Inputs:
    %   H      - [m x n] matrix
    %   C      - [m x (m-n)] nullspace matrix of H'
    %   R_diag - [m x 1] diagonal of R
    %
    % Output:
    %   dM     - cell array of size m, where dM{i} = ∂M/∂r_i
    
    A = C' * diag(R_diag) * C;
    w = inv(A);
    
    m = length(R_diag);
    dM = cell(m, 1);
    
    for i = 1:m
        ci = C(i, :)';                  % (m-n)x1
        dA = ci * ci';                  % rank-1 update
        dM{i} = - (C'*H)' * w * dA * w * (C'*H);  % size n x n
    end
end

